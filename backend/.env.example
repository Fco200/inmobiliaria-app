# Entorno: development | production
NODE_ENV=development

# Puerto del servidor
PORT=5000

# Conexión a MongoDB Atlas (crear clúster en https://www.mongodb.com/atlas)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/crm_inmobiliario?retryWrites=true&w=majority

# Secreto para firmar los tokens JWT (generar uno largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-seguro
JWT_EXPIRES_IN=1d
# Duración del token cuando el usuario elige "Mantener sesión iniciada"
JWT_REMEMBER_EXPIRES_IN=30d

# Orígenes adicionales con acceso a la API (separados por comas).
# El frontend servido por el propio backend NO necesita este valor.
# Ejemplo con Live Server de VS Code:
# CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500
CLIENT_URL=

# Protección contra fuerza bruta en el login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Google Identity Services (registro/login con Google).
# Lo configura el administrador desde Configuración del CRM.
GOOGLE_CLIENT_ID=

# Google Calendar (integración del Calendario interno, OAuth 2 vías).
# Crea un proyecto en https://console.cloud.google.com, habilita la API de
# Google Calendar y una credencial OAuth 2.0 de tipo "App de escritorio" o
# "Aplicación web". REDIRECT_URI debe apuntar al callback del backend, p. ej.:
#   http://localhost:5000/api/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Credenciales del administrador inicial (solo se crean la primera vez que
# arranca con la base vacía). CÁMBIALAS después del primer inicio.
ADMIN_EMAIL=admin@inmobiliaria.com
ADMIN_PASSWORD=CambiaEsto2026!

# Credenciales del usuario de Soporte Técnico (rol SUPERADMIN). Se crean la
# primera vez que arranca junto con el rol. El usuario de soporte tiene acceso
# TOTAL al sistema; cámbialas en producción.
SUPPORT_EMAIL=soporte@inmobiliaria.com
SUPPORT_PASSWORD=Soporte2026!

# Configuracion de ejemplo. Copia los valores necesarios a backend/.env
# (desarrollo) o al panel de variables de entorno de Render (produccion).

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/crm_inmobiliario
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# CORREO SALIENTE
# ---------------------------------------------------------------------------
# Render bloquea los puertos SMTP 25/465/587 en servicios gratuitos. En
# produccion usa una API HTTPS: Brevo, Resend o SendGrid.
#
# Tambien puedes configurarlo desde el CRM: Panel de soporte > Correo. Esa
# configuracion se guarda cifrada en MongoDB, tiene prioridad sobre estas
# variables y se aplica sin reiniciar el servicio.
#
# Brevo (recomendado, 300 correos gratis al dia):
 MAIL_PROVIDER=brevo
BREVO_SENDER_EMAIL=no_responder@inmobles.com
#
# Resend:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=tu_api_key
# RESEND_FROM=correo_verificado@dominio.com
#
# SendGrid:
# MAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=tu_api_key
# SENDGRID_FROM=correo_verificado@dominio.com
#
# SMTP (solo util en local; no funciona en Render gratuito):
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_cuenta@gmail.com
# SMTP_PASS=tu_contrasena_de_aplicacion
# SMTP_SECURE=false

MAIL_FROM=INMOBLES <no-responder@inmobles.com>
# Responder-a opcional (util si el remitente real es una cuenta de Gmail):
# MAIL_REPLY_TO=contacto@inmobles.com

# ---------------------------------------------------------------------------
# ALMACENAMIENTO (fotos y documentos)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=mongodb
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_REGION=auto
# R2_ENDPOINT=

# ---------------------------------------------------------------------------
# NOTIFICACIONES PUSH
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@inmobles.com

# ---------------------------------------------------------------------------
# CUENTA INICIAL
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@inmobiliaria.com
ADMIN_PASSWORD=CambiaEsto2026!
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
